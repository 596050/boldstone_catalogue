{
  "schema_version": 1,
  "description": "One independently tracked Instagram post. Post to must select only the configured Instagram account; an already-correct destination is left untouched. Enable Facebook Story sharing if Meta exposes its switch here; Facebook-only Story controls are handled by the Facebook workflow. Caption, photo, Commerce tag, schedule, boost and native readback remain guarded.",
  "prepare": [
    {
      "op": "ensure_destination",
      "control": [
        {
          "selector": "[role=combobox][aria-haspopup=listbox]"
        }
      ],
      "expanded": [
        {
          "selector": "[role=combobox][aria-haspopup=listbox][aria-expanded=true]"
        }
      ],
      "collapsed": [
        {
          "selector": "[role=combobox][aria-haspopup=listbox][aria-expanded=false]"
        }
      ],
      "selections": [
        {
          "locator": [
            {
              "selector": "[role=option]",
              "name": "$username"
            }
          ],
          "value": true
        },
        {
          "locator": [
            {
              "selector": "[role=option]",
              "name": "$other_account_name"
            }
          ],
          "value": false
        }
      ],
      "checks": [
        {
          "locator": [
            {
              "selector": "[role=combobox][aria-haspopup=listbox]"
            }
          ],
          "contains": "$username",
          "not_contains": "$other_account_name"
        }
      ]
    },
    {
      "op": "set_checked",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Make this an ad post"
        }
      ],
      "value": false,
      "if_exists": true
    },
    {
      "op": "set_checked",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Set date and time"
        }
      ],
      "value": false
    },
    {
      "op": "set_checked",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Boost"
        }
      ],
      "value": false,
      "if_exists": true
    },
    {
      "op": "set_checked",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Share to Facebook story"
        }
      ],
      "value": true,
      "if_exists": true
    },
    {
      "op": "set_text",
      "locator": [
        {
          "selector": "[contenteditable=true][role=combobox]",
          "name": "Write in the dialogue box to include text with your post."
        }
      ],
      "value": "$caption",
      "method": "paste"
    },
    {
      "op": "upload",
      "method": "helper",
      "locator": [
        {
          "selector": "[role=button]",
          "name": "Add photo/video"
        }
      ],
      "preview": [
        {
          "selector": "img.x1lliihq.xjnjwiz[src*='fbcdn.net']"
        }
      ]
    },
    {
      "op": "photo_alt",
      "value": "$alt_text",
      "panel": [
        {
          "selector": "[role=dialog]",
          "contains": "Creative tools",
          "painted": true
        }
      ],
      "open": [
        {
          "selector": "[role=button]",
          "name": "Edit photo"
        }
      ],
      "tab": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Alt text",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Creative tools"
          }
        }
      ],
      "field": [
        {
          "selector": "[role=dialog] textarea",
          "name": "Enter alt text that describes what's in your photo for people using screen readers.",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Creative tools"
          }
        }
      ],
      "apply": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Apply",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Creative tools"
          }
        }
      ],
      "cancel": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Cancel",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Creative tools"
          }
        }
      ]
    },
    {
      "when": "product_tag",
      "op": "product_tag",
      "panel": [
        {
          "selector": "[role=dialog]",
          "contains": "Product tags that you add",
          "painted": true
        }
      ],
      "open": [
        {
          "selector": "[role=button]",
          "name": "Edit"
        }
      ],
      "tab": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Tag products",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Product tags that you add"
          }
        }
      ],
      "photo": [
        {
          "selector": "[role=dialog] img._5i4g"
        }
      ],
      "point_target": [
        {
          "selector": "[role=dialog] .x5lhr3w > button"
        }
      ],
      "search": [
        {
          "selector": "input[role=combobox]",
          "name": "Which product or collection would you like to tag?"
        }
      ],
      "choice": [
        {
          "selector": "[role=option]",
          "name": "$product_tag.name",
          "contains": "$product_tag.price_text"
        }
      ],
      "heading": [
        {
          "selector": "[role=dialog] span[role=heading]",
          "name": "$product_tag.name",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Product tags that you add"
          }
        }
      ],
      "save": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Save",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Product tags that you add"
          }
        }
      ],
      "cancel": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Cancel",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Product tags that you add"
          }
        }
      ],
      "markers": [
        {
          "selector": "[role=dialog] .x5lhr3w > div"
        }
      ],
      "badge": [
        {
          "selector": ".x135b78x > span",
          "text": "1"
        }
      ]
    }
  ],
  "ready": [
    {
      "purpose": "account",
      "locator": [
        {
          "selector": "[role=combobox][aria-haspopup=listbox]"
        }
      ],
      "contains": "$username",
      "not_contains": "$other_account_name"
    },
    {
      "purpose": "boost",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Make this an ad post"
        }
      ],
      "checked": false,
      "if_exists": true
    },
    {
      "purpose": "schedule",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Set date and time"
        }
      ],
      "checked": false
    },
    {
      "purpose": "boost",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Boost"
        }
      ],
      "checked": false,
      "if_exists": true
    },
    {
      "purpose": "story",
      "locator": [
        {
          "selector": "input[type=checkbox]",
          "name": "Share to Facebook story"
        }
      ],
      "checked": true,
      "if_exists": true
    },
    {
      "purpose": "caption",
      "locator": [
        {
          "selector": "[contenteditable=true][role=combobox]",
          "name": "Write in the dialogue box to include text with your post."
        }
      ],
      "text": "$caption"
    },
    {
      "purpose": "photo",
      "locator": [
        {
          "selector": "img.x1lliihq.xjnjwiz[src*='fbcdn.net']"
        }
      ],
      "image": true
    },
    {
      "when": "product_tag",
      "purpose": "tag",
      "locator": [
        {
          "selector": ".x135b78x > span",
          "text": "1"
        }
      ],
      "text": "1",
      "tag_receipt": "$product_tag"
    },
    {
      "purpose": "dialog",
      "locator": [
        {
          "selector": "[role=dialog]",
          "painted": true
        }
      ],
      "absent": true
    }
  ],
  "submit": [
    {
      "selector": "[role=button]",
      "name": "Publish"
    },
    {
      "selector": "button",
      "name": "Publish"
    }
  ],
  "cleanup": [
    {
      "op": "click",
      "locator": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Maybe later",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Are there more posts that you want to publish?"
          }
        },
        {
          "selector": "[role=dialog] button",
          "name": "Maybe later",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Are there more posts that you want to publish?"
          }
        },
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Maybe later",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Your post is published"
          }
        }
      ]
    }
  ],
  "clean_state": {
    "caption": [
      {
        "selector": "[contenteditable=true][role=combobox]",
        "name": "Write in the dialogue box to include text with your post."
      }
    ],
    "preview": [
      {
        "selector": "img.x1lliihq.xjnjwiz[src*='fbcdn.net']"
      }
    ]
  },
  "native_url_pattern": "https://(?:www\\.)?instagram\\.com/(?:[^/?#]+/)?(?:p|reel)/[A-Za-z0-9_-]+/?(?:\\?[^#]*)?",
  "discover": {
    "roots": [
      {
        "selector": "[role=dialog]",
        "contains": "published"
      },
      {
        "selector": "[role=alert]"
      },
      {
        "selector": "[role=status]"
      }
    ]
  },
  "recovery": {
    "url": "$profile_url",
    "steps": [
      {
        "op": "wait",
        "locator": [
          {
            "selector": "a[href*='/p/']",
            "descendant_attribute": {
              "selector": "img",
              "attribute": "alt",
              "contains": "$alt_text"
            }
          }
        ]
      }
    ],
    "discover": {
      "roots": [
        {
          "selector": "a[href*='/p/']",
          "descendant_attribute": {
            "selector": "img",
            "attribute": "alt",
            "contains": "$alt_text"
          }
        }
      ]
    }
  },
  "readback": {
    "root": [
      {
        "selector": "div.x78zum5.x1q0g3np.xh8yej3",
        "contains": "$title"
      }
    ],
    "author": [
      {
        "selector": ":scope > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > span:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1) > span:nth-of-type(1) > div:nth-of-type(1) > a:nth-of-type(1)",
        "name": "$username"
      }
    ],
    "caption_selectors": [
      ":scope > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > span:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)"
    ],
    "photo_selector": "img[style*='object-fit: cover']",
    "expand": [],
    "tag_checks": [
      {
        "locator": [
          {
            "selector": "[role=combobox][aria-haspopup=listbox]"
          }
        ],
        "contains": "$account_name",
        "not_contains": "$other_account_name"
      },
      {
        "locator": [
          {
            "selector": "[contenteditable=true][role=combobox]",
            "name": "Write in the dialogue box to include text with your post."
          }
        ],
        "text": "$caption"
      },
      {
        "locator": [
          {
            "selector": ".x135b78x > span",
            "text": "1"
          }
        ],
        "text": "1"
      }
    ],
    "tag_recovery": {
      "search": [
        {
          "selector": "input[type=text]",
          "name": "Search by ID or caption"
        }
      ],
      "row": [
        {
          "selector": "[role=row]",
          "contains": "$caption"
        }
      ],
      "menu": [
        {
          "selector": "[role=row] [role=button]",
          "name": "Open Drop-down",
          "within": {
            "selector": "[role=row]",
            "contains": "$caption"
          }
        }
      ],
      "manage": [
        {
          "selector": "[role=menu] [role=button]",
          "name": "Manage post"
        }
      ],
      "edit": [
        {
          "selector": "[role=menuitem]",
          "name": "Edit Post"
        }
      ],
      "edit_url_pattern": "https://business\\.facebook\\.com/latest/composer/\\?asset_id=103781478537396&business_id=2380586078685156&ir_qe_exposed=1&business_content_id={post_id}&nav_ref=internal_nav&ref=biz_tools_published_ig_posts_tab_edit_composer&context_ref=POSTS",
      "caption": [
        {
          "selector": "[contenteditable=true][role=combobox]",
          "name": "Write in the dialogue box to include text with your post."
        }
      ],
      "cancel": [
        {
          "selector": "[role=button]",
          "name": "Cancel"
        }
      ],
      "inventory_pattern": "https://business\\.facebook\\.com/latest/posts/published_posts/\\?(?:nav_ref=internal_nav&)?asset_id=103781478537396&business_id=2380586078685156(?:&nav_ref=internal_nav)?",
      "leave": [
        {
          "selector": "[role=dialog]",
          "contains": "Leave Page?"
        }
      ],
      "discard": [
        {
          "selector": "[role=dialog] [role=button]",
          "name": "Discard Changes",
          "within": {
            "selector": "[role=dialog]",
            "contains": "Leave Page?"
          }
        }
      ]
    }
  }
}
